{
  "version": 2,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/webhook", "dest": "server/index.js" },
    { "src": "/health", "dest": "server/index.js" },
    { "src": "/admin(.*)", "dest": "server/index.js" },
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
